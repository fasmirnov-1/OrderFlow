@model string

@{
    ViewData["Title"] = "Ошибка подтверждения";
    Layout = "_ConfirmationError";
}

<div class="page-container">
    <div class="content-card">
        <div class="icon-container">
            <!-- Иконка ошибки -->
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
        </div>

        <h1 class="card-title">Ошибка подтверждения</h1>

        <p class="card-description">
            @(Model ?? "Срок действия ссылки подтверждения истек или она недействительна.")
        </p>
        <p class="card-sub-description">
            Пожалуйста, запросите новое письмо для подтверждения электронной почты в личном кабинете.
        </p>

        <!-- Использование Tag Helpers: asp-controller и asp-action -->
        <button type="button" class="back-button" onclick="location.href='@Url.Action("Index", "Profile")'">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Вернуться назад
        </button>
    </div>
</div>