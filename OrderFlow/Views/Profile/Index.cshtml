@model OrderFlow.Domain.UserProfile
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Views/Shared/_UserProfileEdit.cshtml";
    ViewData["Title"] = "Редактирование профиля";
}

<div class="auth-container">
    <div class="auth-card" style="max-width: 480px;">
        <div class="auth-header">
            <h2>Редактирование профиля</h2>
            <p>Обновите ваши персональные данные и контакты</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert" style="font-size: 14px; margin-bottom: 16px; padding: 10px; border-radius: 6px; background-color: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0;">
                @TempData["SuccessMessage"]
            </div>
        }

        <form id="editProfileForm" asp-action="UpdateProfile" method="post" class="auth-form">
            @Html.AntiForgeryToken()

            <!-- Скрытый хэш сессии, поступающий из модели -->
            <input type="hidden" asp-for="sessionHash" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Скрытое поле ID -->
            <input type="hidden" asp-for="Id" />

            <!-- Имя и Фамилия в строку -->
            <div class="form-group-row">
                <div class="form-group">
                    <label asp-for="FirstName">Имя</label>
                    <input type="text" asp-for="FirstName" placeholder="Иван" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName">Фамилия</label>
                    <input type="text" asp-for="LastName" placeholder="Иванов" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <!-- Логин (UserName) -->
            <div class="form-group">
                <label asp-for="UserName">Логин (Имя пользователя)</label>
                <input type="text" asp-for="UserName" placeholder="ivan_dev" autocomplete="username" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <!-- Email и статус подтверждения -->
            <div class="form-group">
                <label asp-for="Email">Email</label>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <input type="email" asp-for="Email" placeholder="example@orderflow.ru" autocomplete="email" style="flex: 1;" />

                    @if (Model.EmailConfirmed)
                    {
                        <span style="font-size: 12px; font-weight: 500; color: #065f46; background-color: #ecfdf5; padding: 10px 12px; border-radius: 6px; white-space: nowrap; border: 1px solid #a7f3d0;">Подтвержден</span>
                    }
                    else
                    {
                        <span style="font-size: 12px; font-weight: 500; color: #92400e; background-color: #fef3c7; padding: 10px 12px; border-radius: 6px; white-space: nowrap; border: 1px solid #fde68a;">Не подтвержден</span>
                        <button type="submit" asp-controller="PageInDevelopment" asp-action="Index" class="btn-auth-submit" style="margin-top: 0; padding: 10px 14px; width: auto; font-size: 14px; background-color: #4b5563;" formnovalidate>Подтвердить</button>
                    }
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <!-- Телефон и статус/кнопка подтверждения -->
            <div class="form-group">
                <label asp-for="PhoneNumber">Номер телефона</label>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <input type="tel" asp-for="PhoneNumber" placeholder="+7 (999) 000-00-00" autocomplete="tel" style="flex: 1;" />

                    @if (Model.PhoneNumberConfirmed)
                    {
                        <span style="font-size: 12px; font-weight: 500; color: #065f46; background-color: #ecfdf5; padding: 10px 12px; border-radius: 6px; white-space: nowrap; border: 1px solid #a7f3d0;">Подтвержден</span>
                    }
                    else
                    {
                        <span style="font-size: 12px; font-weight: 500; color: #92400e; background-color: #fef3c7; padding: 10px 12px; border-radius: 6px; white-space: nowrap; border: 1px solid #fde68a;">Не подтвержден</span>
                        <button type="submit" asp-controller="PageInDevelopment" asp-action="Index" class="btn-auth-submit" style="margin-top: 0; padding: 10px 14px; width: auto; font-size: 14px; background-color: #4b5563;" formnovalidate>Подтвердить</button>
                    }
                </div>
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <!-- Метаданные аккаунта (Только для чтения) -->
            <div style="background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px; margin-bottom: 16px; font-size: 13px; color: #6b7280;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                    <span>Регистрация:</span>
                    <strong style="color: #374151;">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</strong>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span>Последний вход:</span>
                    <strong style="color: #374151;">@(Model.LastLoginAt.HasValue ? Model.LastLoginAt.Value.ToString("dd.MM.yyyy HH:mm") : "Первый вход")</strong>
                </div>
            </div>

            <!-- Кнопка отправки формы -->
            <button type="submit" id="btnSave" class="btn-auth-submit" style="background-color: #2563eb;">
                <span>Сохранить изменения</span>
                <svg class="icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2 8H14M14 8L10 4M14 8L10 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>

            <!-- Ссылка возврата -->
            <div class="auth-footer" style="text-align: center; margin-top: 16px;">
                <a asp-controller="Home" asp-action="Index" style="font-size: 14px; color: #6b7280; text-decoration: none;">Вернуться на главную</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            var form = $("#editProfileForm");

            form.removeData("validator");
            form.removeData("unobtrusiveValidation");
            $.validator.unobtrusive.parse(form);

            form.on("submit", function (e) {
                if (document.activeElement && document.activeElement.hasAttribute("formnovalidate")) {
                    return true;
                        }

                        if (!form.valid()) {
                    e.preventDefault();
                    return false;
                        }
                    });
                });
    </script>
}