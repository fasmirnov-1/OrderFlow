@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Views/Shared/_Login.cshtml";
    ViewData["Title"] = "Пользователь не найден";
}

<div class="auth-container">
    <div class="auth-card user-not-found-card">

        <div class="info-icon-wrapper">
            <svg class="icon-info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="8.5" cy="7" r="4"></circle>
                <line x1="23" y1="21" x2="16.65" y2="14.65"></line>
            </svg>
        </div>

        <div class="auth-header">
            <h2>Аккаунт не найден</h2>
            <p class="info-message">
                Пользователь с указанным логином отсутствует в системе <strong>OrderFlow</strong>.
                Возможно, вы ошиблись при вводе данных или еще не создавали учетную запись.
            </p>
        </div>

        <div class="navigation-actions">
            <a asp-controller="UserRegister" asp-action="Index" class="btn-auth-submit btn-register-accent">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="8.5" cy="7" r="4"></circle>
                    <line x1="20" y1="8" x2="20" y2="14"></line>
                    <line x1="17" y1="11" x2="23" y2="11"></line>
                </svg>
                <span>Регистрация</span>
            </a>

            <div class="back-to-home-wrapper">
                <a href="/" class="btn-text-secondary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span>Вернуться на главную</span>
                </a>
            </div>
        </div>

    </div>
</div>