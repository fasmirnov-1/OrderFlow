@using OrderFlow.Domain.MainPage;
@using OrderFlow.Domain.MainPage.Models;
@using OrderFlow.Infrastructure.Entities;
@using OrderFlow.Application.Extensions;

@model OrderFlow.Domain.Page;

@{
    Layout = "~/Views/Shared/_Background.cshtml";

    Contacts contacts = Model.Children[Types.Contacts];
    List<Services> services = Model.Children[Types.Services];
    List<Portfolio> portfolios = Model.Children[Types.Portfolio];
    List<Feedback> feedbacks = Model.Children[Types.Feedback];
    Details details = Model.Children[Types.Details];

    int windows = (int)feedbacks.Count / 3;
    int tail = feedbacks.Count % 3;
}

<table id="area" class="workspace">
    <tr id="section-1">
        <td class="heroplace">
            <table class="workspace">
                <tr>
                    <td id="hro" class="heroplacedes">
                        <img id="hroimg" class="workspace" src="~/img/HeroImage.png" alt="Hero Image" />

                        <div class="hero-actions">
                            <button class="btn btn-primary">
                                <span>Заказать проект</span>
                                <svg class="icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M2 8H14M14 8L10 4M14 8L10 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </button>

                            <button class="btn btn-secondary">
                                <svg class="icon icon-play" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M4 2.5V13.5L13 8L4 2.5Z" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                                </svg>
                                <span>Смотреть кейсы</span>
                            </button>
                        </div>
                    </td>
                </tr>
            </table>
        </td>
        <td id="cntcts" class="contactspace">
            <table class="workspace">
                <tr>
                    <td colspan="2" style="text-align:center">
                        <h2 class="contactheader">Контакты</h2>
                    </td>
                </tr>
                <tr>
                    <td class="contacttext">
                        <img src="~/img/Icons/Phone.svg" alt="Phone" />
                        Телефон
                    </td>
                    <td class="contacttext">
                        @contacts.Phone
                    </td>
                </tr>
                <tr>
                    <td class="contacttext">
                        <img src="~/img/Icons/EMail.svg" alt="Email" />
                        Email
                    </td>
                    <td class="contacttext">
                        @contacts.Email
                    </td>
                </tr>
                <tr>
                    <td class="contacttext">
                        <img src="~/img/Icons/Telegram.svg" alt="Telegram" />
                        Telegram
                    </td>
                    <td class="contacttext">
                        @contacts.Telegram
                    </td>
                </tr>
                <tr>
                    <td class="contacttext">
                        <img src="~/img/Icons/Watsap.svg" alt="WhatsApp" />
                        WatsApp
                    </td>
                    <td class="contacttext">
                        @contacts.WatsApp
                    </td>
                </tr>
            </table>
            <hr />
        </td>
    </tr>
    <tr id="section-2">
        <td colspan="2" class="workspace">
            <table class="workspace">
                <tr>
                    @if (services == null || services.Count == 0)
                    {
                        <td style="border: 1px solid black; text-align: center; color: red; font-size: 24pt;">
                            @Html.Raw("Услуги не загружены...")
                        </td>
                    }
                    else
                    {
                        foreach (Services serviceItem in services)
                        {
                            <td>
                                <div class="service-card">
                                    <h3>@serviceItem.Name</h3>
                                    <p>@serviceItem.Description</p>
                                </div>
                            </td>
                        }
                    }
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td colspan="2" class="workspace">
            <div class="workspace">

                <div class="servicesheader">
                    Методологии управления проектами
                </div>

                <table class="workspace" style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                    <tbody>
                        <tr>
                            <td class="methodology-crdplace">
                                <div class="service-card">
                                    <div class="methodology-line blue-line"></div>
                                    <div class="card-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="#1A56DB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                                            <polyline points="17 6 23 6 23 12"></polyline>
                                        </svg>
                                    </div>
                                    <h3>Waterfall</h3>
                                    <span class="methodology-type-badge">Каскадная модель</span>
                                    <p>Классический структурированный подход. Итоговая стоимость, детальное ТЗ и точные сроки полностью утверждаются и фиксируются до начала написания кода.</p>
                                    <div class="methodology-card-footer">
                                        <span class="footer-label">Применение:</span>
                                        <p>Enterprise-системы, ERP и проекты со строгим регламентом.</p>
                                    </div>
                                </div>
                            </td>

                            <td class="methodology-crdplace">
                                <div class="service-card">
                                    <div class="methodology-line purple-line"></div>
                                    <div class="card-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="#7C3AED" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                                        </svg>
                                    </div>
                                    <h3>Прототипирование</h3>
                                    <span class="methodology-type-badge purple-badge">Agile / Итеративный подход</span>
                                    <p>Гибкая разработка с фокусом на быстрый запуск MVP за 2 недели. Позволяет динамически изменять требования на основе обратной связи от пользователей.</p>
                                    <div class="methodology-card-footer">
                                        <span class="footer-label">Применение:</span>
                                        <p>SaaS-платформы, стартапы и продукты с гибким рынком.</p>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </td>
    </tr>
    <tr>
        <td colspan="2" class="workspace">
            <div class="workspace">

                <div class="servicesheader" style="margin-top: 40px; margin-bottom: 30px;">
                    Наши проекты (Портфолио)
                </div>

                <table style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                    <tbody>
                        <tr>
                            @if (portfolios == null || portfolios.Count == 0)
                            {
                                <td class="workspace" style="text-align: center; color: red; font-size: 24pt; border: 1px solid black;">
                                    Портфолио не загружено...
                                </td>
                            }
                            else
                            {
                                foreach (Portfolio portfolio in portfolios)
                                {
                                    <td class="crdplace" style="vertical-align: top; padding: 15px;">
                                        <div class="service-card">
                                            <div class="portfolio-line blue-line"></div>
                                            <div class="portfolio-preview">
                                                <span class="portfolio-badge">CRM</span>
                                                <div class="preview-placeholder">B2B Dashboard</div>
                                            </div>
                                            <h3 class="portfolio-title">@portfolio.ProjectName.Title</h3>
                                            <div class="meta-item">
                                                <strong>Стек:</strong> @portfolio.TechnologyName
                                            </div>
                                            <div class="portfolio-meta">
                                                <div class="meta-item">
                                                    <strong>Методология: </strong>@portfolio.Metodology.Mtdology.Value.ToRussian()
                                                </div>
                                            </div>
                                            <a href="#" class="portfolio-link">
                                                <span>Подробнее о кейсе</span>
                                                <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 1.1em; height: 1.1em;">
                                                    <path d="M2 8H14M14 8L10 4M14 8L10 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                                </svg>
                                            </a>
                                        </div>
                                    </td>
                                }
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        </td>
    </tr>
    <tr>
        <td colspan="2" class="workspace">
            <div class="workspace">

                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 40px; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
                    <div class="servicesheader" style="text-align: left; margin: 0;">
                        Отзывы наших клиентов
                    </div>

                    <a href="#" class="portfolio-link login-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 1.2em; height: 1.2em;">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M13.8 12H3" />
                        </svg>
                        <span>Вход в панель</span>
                    </a>
                </div>
                <table class="workspace">
                    @if (feedbacks != null && feedbacks.Count > 0)
                    {
                        @for (int i = 0; i < windows; i++)
                        {
                            <tr>
                                @for (int g = 0; g < 3; g++)
                                {
                                    <td class="crdplace" style="vertical-align: top; padding: 15px;">
                                        <div class="service-card">
                                            <div class="reviews-line blue-line"></div>
                                            <div class="reviews-rating">
                                                @if(feedbacks[i + g].Raiting > 0)
                                                {
                                                    for (int k = 0; k < (int)feedbacks[i + g].Raiting; k++)
                                                    {
                                                        <span class="star-icon">★</span>
                                                    }
                                                }
                                            </div>
                                            <p class="reviews-text">@feedbacks[i + g].Text</p>
                                            <div class="reviews-author-meta">
                                                <div class="author-avatar">@feedbacks[i + g].Name[0]@feedbacks[i + g].Name.Split(" ")[1][0]</div>
                                                <div>
                                                    <h4 class="author-name">@feedbacks[i + g].Name</h4>
                                                    <span class="author-company">@feedbacks[i + g].Company</span>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }

                        @if (tail > 0)
                        {
                            <tr>
                                @for (int i = 0; i < tail; i++)
                                {
                                    <td class="crdplace" style="vertical-align: top; padding: 15px;">
                                        <div class="service-card">
                                            <div class="reviews-line blue-line"></div>
                                            <div class="reviews-rating">
                                                @if (feedbacks[i].Raiting > 0)
                                                {
                                                    for (int k = 0; k < (int)feedbacks[i].Raiting; k++)
                                                    {
                                                        <span class="star-icon">★</span>
                                                    }
                                                }
                                            </div>
                                            <p class="reviews-text">@feedbacks[i].Text</p>
                                            <div class="reviews-author-meta">
                                                <div class="author-avatar">@feedbacks[i].Name[0]@feedbacks[i].Name.Split(" ")[1][0]</div>
                                                <div>
                                                    <h4 class="author-name">@feedbacks[i].Name</h4>
                                                    <span class="author-company">@feedbacks[i].Company</span>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td>
                        <div class="workspace" style="box-sizing: border-box;">

                            <table style="width: 100%; border-collapse: collapse; table-layout: fixed; height: auto;">
                                <tbody>
                                    <tr>
                                        <td style="padding: 1vh 1vw !important; vertical-align: middle;">

                                            <div class="service-card" style="
                                                position: relative;
                                                padding: clamp(15px, 2.5vh, 35px) clamp(20px, 3vw, 40px) !important;
                                                min-height: clamp(140px, 20vh, 260px) !important;
                                                height: auto !important;
                                                margin: 0 auto;
                                                display: flex;
                                                flex-direction: column;
                                                align-items: center;
                                                justify-content: center;
                                                text-align: center;
                                                box-sizing: border-box;
                                                ">

                                                <div style="position: absolute; top: 0; left: 0; width: 100%; height: 4px; background-color: #D1D5DB;"></div>

                                                <div style="
                                                    width: clamp(32px, 4.5vh, 48px) !important;
                                                    height: clamp(32px, 4.5vh, 48px) !important;
                                                    background-color: #F9FAFB;
                                                    border: 1px dashed #D1D5DB;
                                                    border-radius: 50%;
                                                    display: flex;
                                                    align-items: center;
                                                    justify-content: center;
                                                    margin-top: 0.5vh !important;
                                                    margin-bottom: 1.5vh !important;
                                                    color: #9CA3AF;
                                                    flex-shrink: 0;
                                                    ">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 50%; height: 50%;">
                                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                                        <polygon points="12 7 13.5 10 16.5 10 14 12 15 15 12 13.5 9 15 10 12 7.5 10 10.5 10" fill="rgba(251, 191, 36, 0.1)" stroke="#FBBF24" stroke-width="1"></polygon>
                                                    </svg>
                                                </div>

                                                <h3 style="
                                                    font-size: clamp(14px, 2vh, 18px) !important;
                                                    font-weight: 700;
                                                    color: #374151;
                                                    margin: 0 0 1vh 0 !important;
                                                    padding: 0 !important;
                                                    line-height: 1.2 !important;
                                                    ">
                                                    Отзывов пока нет
                                                </h3>

                                                <p style="
                                                    font-size: clamp(11px, 1.45vh, 14px) !important;
                                                    color: #6B7280;
                                                    max-width: 90%;
                                                    line-height: 1.4 !important;
                                                    margin: 0 0 2vh 0 !important;
                                                    padding: 0 !important;
                                                    ">
                                                    Мы только заполняем этот раздел реальными кейсами. Если мы уже успешно разработали для вас проект — поделитесь вашим мнением!
                                                </p>
                                                <!--Сдесь проверить, что пользователь авторизован, если да - показать кнопку, нет - кнопка сврятана... -->
                                                <!--<button type="button" class="btn btn-primary" style="
                                                padding: clamp(6px, 1vh, 10px) clamp(14px, 1.8vw, 22px) !important;
                                                font-size: clamp(11px, 1.4vh, 13px) !important;
                                                min-width: auto !important;
                                                width: auto !important;
                                                height: auto !important;
                                                border-radius: 6px !important;
                                                display: inline-flex;
                                                align-items: center;
                                                justify-content: center;
                                                " onclick="document.getElementById('order-form-section')?.scrollIntoView({behavior: 'smooth'});">
                                                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 1.2em; height: 1.2em; margin-right: 6px; flex-shrink: 0;">
                                                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                                                </svg>
                                                <span>Оставить первый отзыв</span>
                                            </button>-->

                                            </div>

                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        </td>
                        </tr>
                    }
                </table>
            </div>
        </td>
    </tr>
    <tr>
        <td colspan="2">
            <div class="requisites-block" style="
                display: block;
                width: 100%;
                margin: 10px auto;
                background: #ffffff;
                border: 1px solid #e5e7eb;
                border-radius: 12px;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
                font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                box-sizing: border-box;
                overflow: hidden;
                position: relative;
                z-index: 1;
                ">
                <div style="
                    padding: 18px 24px;
                    background: #f9fafb;
                    border-bottom: 1px solid #e5e7eb;
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    ">
                    <h3 style="margin: 0; font-size: 16px; font-weight: 600; color: #111827;">
                        Мои реквизиты
                    </h3>
                    <span style="font-size: 12px; color: #6b7280; background: #e5e7eb; padding: 2px 6px; border-radius: 4px; font-weight: 500;">
                        Самозанятый
                    </span>
                </div>

                <div style="padding: 8px 24px;">

                    <div class="req-row" style="display: flex; flex-wrap: wrap; padding: 12px 0; border-bottom: 1px dashed #f3f4f6; align-items: center;">
                        <div style="flex: 1; min-width: 160px; font-size: 13px; color: #6b7280; padding-right: 10px; margin-bottom: 4px;">
                            ФИО
                        </div>
                        <div style="flex: 2; min-width: 220px; font-size: 14px; font-weight: 500; color: #111827; display: flex; align-items: center; justify-content: space-between;">
                            <span>Смирнов Федор Александрович</span>
                        </div>
                    </div>

                    <div class="req-row" style="display: flex; flex-wrap: wrap; padding: 12px 0; border-bottom: 1px dashed #f3f4f6; align-items: center;">
                        <div style="flex: 1; min-width: 160px; font-size: 13px; color: #6b7280; padding-right: 10px; margin-bottom: 4px;">
                            ИНН
                        </div>
                        <div style="flex: 2; min-width: 220px; font-size: 14px; font-weight: 500; color: #111827; display: flex; align-items: center; justify-content: space-between;">
                            <span style="font-family: monospace; font-size: 15px; letter-spacing: 0.5px;">@details.Inn</span>
                            <button title="Копировать" onclick="navigator.clipboard.writeText(@details.Inn)" style="background: none; border: none; cursor: pointer; color: #9ca3af; padding: 4px; display: flex; align-items: center;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                            </button>
                        </div>
                    </div>

                    <div class="req-row" style="display: flex; flex-wrap: wrap; padding: 12px 0; border-bottom: 1px dashed #f3f4f6; align-items: center;">
                        <div style="flex: 1; min-width: 160px; font-size: 13px; color: #6b7280; padding-right: 10px; margin-bottom: 4px;">
                            КПП
                        </div>
                        <div style="flex: 2; min-width: 220px; font-size: 14px; font-weight: 500; color: #111827; display: flex; align-items: center; justify-content: space-between;">
                            <span style="font-family: monospace; font-size: 15px; letter-spacing: 0.5px;">@details.Kpp</span>
                            <button title="Копировать" onclick="navigator.clipboard.writeText(@details.Kpp)" style="background: none; border: none; cursor: pointer; color: #9ca3af; padding: 4px; display: flex; align-items: center;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg></button>
                        </div>
                    </div>

                    <div class="req-row" style="display: flex; flex-wrap: wrap; padding: 12px 0; border-bottom: 1px dashed #f3f4f6; align-items: center;">
                        <div style="flex: 1; min-width: 160px; font-size: 13px; color: #6b7280; padding-right: 10px; margin-bottom: 4px;">
                            Расчетный счет (Р/с)
                        </div>
                        <div style="flex: 2; min-width: 220px; font-size: 14px; font-weight: 600; color: #2563eb; display: flex; align-items: center; justify-content: space-between;">
                            <span style="font-family: monospace; font-size: 15px; letter-spacing: 0.5px;">@details.Check</span>
                            <button title="Копировать" onclick="navigator.clipboard.writeText(@details.Check)" style="background: none; border: none; cursor: pointer; color: #9ca3af; padding: 4px; display: flex; align-items: center;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg></button>
                        </div>
                    </div>

                    <div class="req-row" style="display: flex; flex-wrap: wrap; padding: 12px 0; border-bottom: 1px dashed #f3f4f6; align-items: center;">
                        <div style="flex: 1; min-width: 160px; font-size: 13px; color: #6b7280; padding-right: 10px; margin-bottom: 4px;">
                            Наименование банка
                        </div>
                        <div style="flex: 2; min-width: 220px; font-size: 14px; font-weight: 500; color: #111827; display: flex; align-items: center; justify-content: space-between;">
                            <span>@details.BankName</span>
                        </div>
                    </div>

                </div>

                <div style="padding: 12px 24px; background: #f9fafb; border-top: 1px solid #e5e7eb; text-align: right;">
                    <button type="button" style="background: #ffffff; color: #374151; border: 1px solid #d1d5db; padding: 6px 12px; font-size: 12px; font-weight: 500; border-radius: 6px; cursor: pointer; box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);" onclick="navigator.clipboard.writeText('Смирнов Федор Александрович\nИНН: @details.Inn\nКПП: @details.Kpp\nР/с: @details.Check\nБанк: @details.BankName'); alert('Все реквизиты скопированы в буфер обмена!');">
                        Скопировать все реквизиты
                    </button>
                </div>
            </div>
        </td>
    </tr>
</table>
<script type="text/javascript" src="~/Scripts/jquery-4.0.0.min.js"></script>
<script type="text/javascript" src="~/Scripts/Background_v1.js"></script>

<script type="text/javascript">
    $("#area").css("height", getHeightInPx(92));
    $("#section-1").css("height", getHeightInPx(60)); /* Исправлена опечатка в id селектора */
    $("#section-2").css("height", getHeightInPx(30)); /* Исправлена опечатка в id селектора */
    $("#hro").css("height", getHeightInPx(60));
    $("#hroimg").css("height", getHeightInPx(60));
    $("#cntcts").css("height", getHeightInPx(58));
</script>