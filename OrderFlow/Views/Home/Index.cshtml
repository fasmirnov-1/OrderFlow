@using OrderFlow.Domain.MainPage;
@using OrderFlow.Domain.MainPage.Models;
@using OrderFlow.Infrastructure.Entities;
@using OrderFlow.Application.Extensions;
@using Wangkanai.Detection.Models;

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@inject Wangkanai.Detection.Services.IDetectionService DetectionService

@model OrderFlow.Domain.Page;
@{
    Layout = "~/Views/Shared/_Background.cshtml";

    ViewData["Title"] = "Создание приложений на заказ и автоматизация бизнеса";
    ViewData["MetaDescription"] = "OrderFlow — ваш программист в мире автоматизации. Мы осуществляем создание приложений на заказ любой сложности. Удобные, надежные и доступные программы для всех сфер бизнеса.";
    ViewData["MetaKeywords"] = "создание приложений на заказ, программы для всех, ваш программист, orderflow, разработка по, автоматизация процессов";
    ViewData["CanonicalUrl"] = "http://createsoft.orderflow.abrdns.com/";

    Contacts contacts = Model.Children[Types.Contacts];
    List<OrderFlow.Domain.MainPage.Models.Service> services = Model.Children[Types.Services];
    List<Portfolio> portfolios = Model.Children[Types.Portfolio];
    List<Feedback> feedbacks = Model.Children[Types.Feedback];
    Details details = Model.Children[Types.Details];

    int windows = feedbacks != null ? feedbacks.Count / 3 : 0;
    int tail = feedbacks != null ? feedbacks.Count % 3 : 0;
}

@Html.AntiForgeryToken()

<!-- Баннер-предупреждение о необходимости функции (скрыт по умолчанию) -->
<div id="cryptoWarningBanner" style="display:none; background: #fff3cd; color: #856404; border-bottom: 1px solid #ffeeba; padding: 12px 20px; text-align: center; font-size: 14px; position: relative; z-index: 100000; box-sizing: border-box;">
    <span><strong>Внимание:</strong> Криптографическая защита (Web Crypto API) ограничена протоколом HTTP.</span>
    <button type="button" onclick="runBrowserCryptoFix()" style="background: #856404; color: #fff; border: none; padding: 5px 12px; margin-left: 15px; border-radius: 4px; cursor: pointer; font-size: 13px; font-weight: 500;">Настроить браузер</button>
    <button type="button" onclick="document.getElementById('cryptoWarningBanner').style.display='none';" style="background: transparent; border: none; font-size: 16px; font-weight: bold; cursor: pointer; margin-left: 10px; color: #856404;">&times;</button>
</div>

<table id="area" class="workspace">
    <tr id="section-1">
        <td class="heroplace">
            <table class="workspace">
                <tr>
                    <td id="hro" class="heroplacedes">
                        <div class="hero-content-wrapper">
                            <div class="hero-actions">
                                <div class="tunnel-form-surrogate">
                                    <button type="button" class="btn btn-primary" onclick="securePostRedirect('/PageInDevelopment/Index', { action: 'order' })">
                                        <span>Заказать проект</span>
                                        <svg class="icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M2 8H14M14 8L10 4M14 8L10 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </button>

                                    <button type="button" class="btn btn-secondary" onclick="securePostRedirect('/PageInDevelopment/Index', { action: 'cases' })">
                                        <svg class="icon icon-play" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M4 2.5V13.5L13 8L4 2.5Z" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                                        </svg>
                                        <span>Смотреть кейсы</span>
                                    </button>

                                    <div class="login-blur-wrapper" style="position: relative; display: inline-block;">
                                        @if (User.Identity.IsAuthenticated)
                                        {
                                            <div class="user-profile-container" style="position: relative; display: inline-block;">
                                                <div class="user-profile-name" onclick="toggleUserDropdown(event)" style="cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 8px 16px; background: rgba(255,255,255,0.1); border-radius: 6px; color: #fff; user-select: none;">
                                                    <span>@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value</span>
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                                </div>

                                                <div id="userDropdown" class="user-dropdown-menu" style="display: none; position: absolute; top: 100%; right: 0; mt: 5px; background: #ffffff; min-width: 200px; border: 1px solid #e5e7eb; border-radius: 8px; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); z-index: 99999; padding: 6px 0;">
                                                    <!-- РАБОЧИЙ ВЫЗОВ ПРОФИЛЯ ЧЕРЕЗ ТУННЕЛЬ -->
                                                    <a class="user-dropdown-item" onclick="openProfileSession()" style="display: block; padding: 10px 16px; color: #374151; cursor: pointer; text-decoration: none; font-size: 14px;">Редактировать профиль</a>
                                                    <div class="user-dropdown-divider" style="height: 1px; background-color: #e5e7eb; margin: 4px 0;"></div>
                                                    <a class="user-dropdown-item" onclick="handleLogout(event)" style="display: block; padding: 10px 16px; color: #dc2626; cursor: pointer; text-decoration: none; font-size: 14px; font-weight: 500;">Выход</a>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-login-hero" onclick="securePostRedirect('/Login/Index', {})">
                                                <svg class="icon icon-login" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 16px; height: 16px; margin-right: 8px; display: inline-block; vertical-align: middle;">
                                                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M13.8 12H3" />
                                                </svg>
                                                <span>Логин</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="hero-overlay"></div>
                    </td>
                </tr>
            </table>
        </td>
        <td id="cntcts" class="contactspace">
            <div class="contacts-mobile-wrapper">
                <h2 class="contactheader" style="text-align: center; margin-bottom: 24px;">Контакты</h2>

                <div class="mobile-contact-card">
                    <div class="contact-label">
                        <img src="~/img/Icons/Phone.svg" alt="Phone" />
                        <span>Телефон</span>
                    </div>
                    <a href="tel:@contacts.Phone" class="contact-value">@contacts.Phone</a>
                </div>

                <div class="mobile-contact-card">
                    <div class="contact-label">
                        <img src="~/img/Icons/EMail.svg" alt="Email" />
                        <span>Email</span>
                    </div>
                    <a href="mailto:@contacts.Email" class="contact-value">@contacts.Email</a>
                </div>

                <div class="mobile-contact-card">
                    <div class="contact-label">
                        <img src="~/img/Icons/Telegram.svg" alt="Telegram" />
                        <span>Telegram</span>
                    </div>
                    <a href="https://t.me/@contacts.Telegram.Replace("@", "")" target="_blank" class="contact-value">@contacts.Telegram</a>
                </div>

                <div class="mobile-contact-card">
                    <div class="contact-label">
                        <img src="~/img/Icons/Watsap.svg" alt="WhatsApp" />
                        <span>WhatsApp</span>
                    </div>
                    <a href="https://wa.me/@contacts.WatsApp.Replace(" ", "").Replace("-", "").Replace("(", "").Replace(")", "")" target="_blank" class="contact-value">@contacts.WatsApp</a>
                </div>
            </div>
            <hr />
        </td>
    </tr>
    <tr id="section-2">
        <td colspan="2" class="workspace">
            <table class="workspace">
                <tr>
                    @if (services == null || services.Count == 0)
                    {
                        <td style="border: 1px solid black; text-align: center; color: red; font-size: 24pt;">
                            @Html.Raw("Услуги не загружены...")
                        </td>
                    }
                    else
                    {
                        foreach (OrderFlow.Domain.MainPage.Models.Service serviceItem in services)
                        {
                            <td>
                                <div class="service-card">
                                    <h3>@serviceItem.Name</h3>
                                    <p>@serviceItem.Description</p>
                                </div>
                            </td>
                        }
                    }
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td colspan="2" class="workspace">
            <div class="workspace">
                <div class="servicesheader">Методологии управления проектами</div>
                <table class="workspace" style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                    <tbody>
                        <tr>
                            <td class="methodology-crdplace">
                                <div class="service-card">
                                    <div class="methodology-line blue-line"></div>
                                    <div class="card-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="#1A56DB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                                            <polyline points="17 6 23 6 23 12"></polyline>
                                        </svg>
                                    </div>
                                    <h3>Waterfall</h3>
                                    <span class="methodology-type-badge">Каскадная модель</span>
                                    <p>Классический структурированный подход. Итоговая стоимость, детальное ТЗ и точные сроки полностью утверждаются и фиксируются до начала написания кода.</p>
                                    <div class="methodology-card-footer">
                                        <span class="footer-label">Применение:</span>
                                        <p>Enterprise-системы, ERP и проекты со строгим регламентом.</p>
                                    </div>
                                </div>
                            </td>
                            <td class="methodology-crdplace">
                                <div class="service-card">
                                    <div class="methodology-line purple-line"></div>
                                    <div class="card-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="#7C3AED" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                                        </svg>
                                    </div>
                                    <h3>Прототипирование</h3>
                                    <span class="methodology-type-badge purple-badge">Agile / Итеративный подход</span>
                                    <p>Гибкая разработка с фокусом на быстрый запуск MVP за 2 недели. Позволяет динамически изменять требования на основе обратной связи от пользователей.</p>
                                    <div class="methodology-card-footer">
                                        <span class="footer-label">Применение:</span>
                                        <p>SaaS-платформы, стартапы и продукты с гибким рынком.</p>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </td>
    </tr>
    <tr>
        <td colspan="2" class="workspace">
            <div class="workspace">
                <div class="servicesheader" style="margin-top: 40px; margin-bottom: 30px;">Наши проекты (Портфолио)</div>
                <table style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                    <tbody>
                        <tr>
                            @if (portfolios == null || portfolios.Count == 0)
                            {
                                <td class="workspace" style="text-align: center; color: red; font-size: 24pt; border: 1px solid black;">Портфолио не загружено...</td>
                            }
                            else
                            {
                                foreach (Portfolio portfolio in portfolios)
                                {
                                    <td class="crdplace" style="vertical-align: top; padding: 15px;">
                                        <div class="service-card">
                                            <div class="portfolio-line blue-line"></div>

                                            @if (DetectionService.Device.Type != Device.Mobile)
                                            {
                                                <div class="portfolio-preview">
                                                    <span class="portfolio-badge">@portfolio.ProjectName.Title</span>
                                                    <div class="preview-placeholder">&nbsp;</div>
                                                </div>
                                            }

                                            <h3 class="portfolio-title">@portfolio.ProjectName.Title</h3>
                                            <div class="meta-item"><strong>Стек:</strong> @portfolio.TechnologyName</div>
                                            <div class="portfolio-meta">
                                                <div class="meta-item"><strong>Методология: </strong>@portfolio.Metodology.Mtdology.Value.ToRussian()</div>
                                            </div>

                                            <a href="/PageInDevelopment/Index" onclick="event.preventDefault(); securePostRedirect('/PageInDevelopment/Index', { projectId: '@portfolio.ProjectName.Title' });">
                                                <span>Подробнее о кейсе</span>
                                                <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 1.1em; height: 1.1em; margin-left: 5px; display: inline-block; vertical-align: middle;">
                                                    <path d="M2 8H14M14 8L10 4M14 8L10 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                                </svg>
                                            </a>
                                        </div>
                                    </td>
                                }
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        </td>
    </tr>
    <tr>
        <td colspan="2" class="workspace">
            <div class="workspace">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 40px; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
                    <div class="servicesheader" style="text-align: left; margin: 0;">Отзывы наших клиентов</div>
                </div>
                <table class="workspace">
                    @if (feedbacks != null && feedbacks.Count > 0)
                    {
                        @for (int i = 0; i < windows; i++)
                        {
                            <tr>
                                @for (int g = 0; g < 3; g++)
                                {
                                    int currentIndex = (i * 3) + g;
                                    <td class="crdplace" style="vertical-align: top; padding: 15px;">
                                        <div class="service-card">
                                            <div class="reviews-line blue-line"></div>
                                            <div class="reviews-rating">
                                                @if (feedbacks[currentIndex].Raiting > 0)
                                                {
                                                    for (int k = 0; k < (int)feedbacks[currentIndex].Raiting; k++)
                                                    {
                                                        <span class="star-icon">★</span>
                                                    }
                                                }
                                            </div>
                                            <p class="reviews-text">@feedbacks[currentIndex].Text</p>
                                            <div class="reviews-author-meta">
                                                @{
                                                    var words = feedbacks[currentIndex].Name.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                                                    string initials = words.Length > 1 ? $"{words[0][0]}{words[1][0]}" : $"{words[0][0]}";
                                                }
                                                <div class="author-avatar">@initials</div>
                                                <div>
                                                    <h4 class="author-name">@feedbacks[currentIndex].Name</h4>
                                                    <span class="author-company">@feedbacks[currentIndex].Company</span>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                        @if (tail > 0)
                        {
                            <tr>
                                @for (int j = 0; j < tail; j++)
                                {
                                    int tailIndex = (windows * 3) + j;
                                    <td class="crdplace" style="vertical-align: top; padding: 15px;">
                                        <div class="service-card">
                                            <div class="reviews-line blue-line"></div>
                                            <div class="reviews-rating">
                                                @if (feedbacks[tailIndex].Raiting > 0)
                                                {
                                                    for (int k = 0; k < (int)feedbacks[tailIndex].Raiting; k++)
                                                    {
                                                        <span class="star-icon">★</span>
                                                    }
                                                }
                                            </div>
                                            <p class="reviews-text">@feedbacks[tailIndex].Text</p>
                                            <div class="reviews-author-meta">
                                                @{
                                                    var wordsTail = feedbacks[tailIndex].Name.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                                                    string initialsTail = wordsTail.Length > 1 ? $"{wordsTail[0][0]}{wordsTail[1][0]}" : $"{wordsTail[0][0]}";
                                                }
                                                <div class="author-avatar">@initialsTail</div>
                                                <div>
                                                    <h4 class="author-name">@feedbacks[tailIndex].Name</h4>
                                                    <span class="author-company">@feedbacks[tailIndex].Company</span>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td>
                                <div class="workspace" style="box-sizing: border-box;">
                                    <table style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                                        <tbody>
                                            <tr>
                                                <td style="padding: 1vh 1vw !important; vertical-align: middle;">
                                                    <div class="service-card" style="position: relative; padding: clamp(15px, 2.5vh, 35px) clamp(20px, 3vw, 40px) !important; min-height: clamp(140px, 20vh, 260px) !important; height: auto !important; margin: 0 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; box-sizing: border-box;">
                                                        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 4px; background-color: #D1D5DB;"></div>
                                                        <div style="width: clamp(32px, 4.5vh, 48px) !important; height: clamp(32px, 4.5vh, 48px) !important; background-color: #F9FAFB; border: 1px dashed #D1D5DB; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5vh !important; color: #9CA3AF;">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 50%; height: 50%;">
                                                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                                                <polygon points="12 7 13.5 10 16.5 10 14 12 15 15 12 13.5 9 15 10 12 7.5 10 10.5 10" fill="rgba(251, 191, 36, 0.1)" stroke="#FBBF24" stroke-width="1"></polygon>
                                                            </svg>
                                                        </div>
                                                        <h3 style="font-size: clamp(14px, 2vh, 18px) !important; font-weight: 700; color: #374151; margin: 0 0 1vh 0 !important; line-height: 1.2 !important;">Отзывов пока нет</h3>
                                                        <p style="font-size: clamp(11px, 1.45vh, 14px) !important; color: #6B7280; max-width: 90%; line-height: 1.4 !important; margin: 0 !important;">Мы только заполняем этот раздел реальными кейсами.</p>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    }
                </table>
            </div>
        </td>
    </tr>
    <tr>
        <td colspan="2">
            <div class="requisites-block" style="display: block; width: 100%; margin: 10px auto; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); font-family: system-ui, -apple-system, sans-serif; box-sizing: border-box; overflow: hidden; position: relative; z-index: 1;">
                <div style="padding: 18px 24px; background: #f9fafb; border-bottom: 1px solid #e5e7eb; display: flex; align-items: center; justify-content: space-between;">
                    <h3 style="margin: 0; font-size: 16px; font-weight: 600; color: #111827;">Мои реквизиты</h3>
                    <span style="font-size: 12px; color: #6b7280; background: #e5e7eb; padding: 2px 6px; border-radius: 4px; font-weight: 500;">Самозанятый</span>
                </div>
                <div style="padding: 8px 24px;">
                    <div class="req-row" style="display: flex; flex-wrap: wrap; padding: 12px 0; border-bottom: 1px dashed #f3f4f6; align-items: center;">
                        <div style="flex: 1; min-width: 160px; font-size: 13px; color: #6b7280;">ФИО</div>
                        <div style="flex: 2; min-width: 220px; font-size: 14px; font-weight: 500; color: #111827;"><span>Смирнов Федор Александрович</span></div>
                    </div>
                    <div class="req-row" style="display: flex; flex-wrap: wrap; padding: 12px 0; border-bottom: 1px dashed #f3f4f6; align-items: center;">
                        <div style="flex: 1; min-width: 160px; font-size: 13px; color: #6b7280;">ИНН</div>
                        <div style="flex: 2; min-width: 220px; font-size: 14px; font-weight: 500; color: #111827; display: flex; align-items: center; justify-content: space-between;">
                            <span style="font-family: monospace; font-size: 15px; letter-spacing: 0.5px;">@details.Inn</span>
                            <button title="Копировать" onclick="navigator.clipboard.writeText('@details.Inn')" style="background: none; border: none; cursor: pointer; color: #9ca3af; padding: 4px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg></button>
                        </div>
                    </div>
                    <div class="req-row" style="display: flex; flex-wrap: wrap; padding: 12px 0; border-bottom: 1px dashed #f3f4f6; align-items: center;">
                        <div style="flex: 1; min-width: 160px; font-size: 13px; color: #6b7280;">Расчетный счет (Р/с)</div>
                        <div style="flex: 2; min-width: 220px; font-size: 14px; font-weight: 600; color: #2563eb; display: flex; align-items: center; justify-content: space-between;">
                            <span style="font-family: monospace; font-size: 15px; letter-spacing: 0.5px;">@details.Check</span>
                            <button title="Копировать" onclick="navigator.clipboard.writeText('@details.Check')" style="background: none; border: none; cursor: pointer; color: #9ca3af; padding: 4px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg></button>
                        </div>
                    </div>
                    <div class="req-row" style="display: flex; flex-wrap: wrap; padding: 12px 0; align-items: center;">
                        <div style="flex: 1; min-width: 160px; font-size: 13px; color: #6b7280;">Наименование банка</div>
                        <div style="flex: 2; min-width: 220px; font-size: 14px; font-weight: 500; color: #111827;"><span>@details.BankName</span></div>
                    </div>
                </div>
                <div style="padding: 12px 24px; background: #f9fafb; border-top: 1px solid #e5e7eb; text-align: right;">
                    <button type="button" style="background: #ffffff; color: #374151; border: 1px solid #d1d5db; padding: 6px 12px; font-size: 12px; font-weight: 500; border-radius: 6px; cursor: pointer;" onclick="navigator.clipboard.writeText('Смирнов Федор Александрович\nИНН: @details.Inn\nР/с: @details.Check\nБанк: @details.BankName'); alert('Все реквизиты скопированы!');">Скопировать все реквизиты</button>
                </div>
            </div>
        </td>
    </tr>
</table>

<!-- Скрытая форма для безопасного открытия профиля через крипто-туннель -->
<form id="profileTunnelForm" asp-controller="Profile" asp-action="Index" method="post" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="profileEncryptedPayload" name="encryptedPayload" />
</form>

<script type="text/javascript" src="~/Scripts/jquery-4.0.0.min.js"></script>
<script type="text/javascript" src="~/Scripts/Background_v1.js"></script>
<script type="text/javascript" src="~/Scripts/crypto-tunnel.js"></script>

<script type="text/javascript">
    // Автоматическая проверка при загрузке страницы
    document.addEventListener("DOMContentLoaded", function() {
        const isCryptoSupported = window.crypto && window.crypto.subtle && typeof window.crypto.subtle.digest === 'function';
        if (!isCryptoSupported) {
            var banner = document.getElementById("cryptoWarningBanner");
            if (banner) {
                banner.style.display = "block";
            }
        }
    });

    // Открытие/закрытие меню через прямую манипуляцию стилем display
    function toggleUserDropdown(event) {
        event.stopPropagation();
        var dropdown = document.getElementById("userDropdown");
        if (dropdown) {
            if (dropdown.style.display === "none" || dropdown.style.display === "") {
                dropdown.style.display = "block";
            } else {
                dropdown.style.display = "none";
            }
        }
    }

    // Закрытие меню при клике в любую точку экрана
    window.addEventListener("click", function() {
        var dropdown = document.getElementById("userDropdown");
        if (dropdown) {
            dropdown.style.display = "none";
        }
    });

    // Специализированный метод для безопасного выхода из системы
    function handleLogout(event) {
        event.preventDefault();
        var token = $('input[name="__RequestVerificationToken"]').val();
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Login/Logout';

        if (token) {
            var tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = token;
            form.appendChild(tokenInput);
        }

        document.body.appendChild(form);
        form.submit();
    }

    async function securePostRedirect(targetUrl, payload) {
        try {
            const response = await sendTunnelRequest(targetUrl, payload);
            if (response.ok) {
                window.location.href = targetUrl;
            } else {
                console.warn("Туннель отклонен сервером, пробуем прямой переход.");
                window.location.href = targetUrl;
            }
        } catch (e) {
            console.error("Ошибка крипто-туннеля:", e);
            window.location.href = targetUrl;
        }
    }

    // ИСПРАВЛЕННЫЙ МЕТОД: Формирование Base64 пакета аналогично авторизации и отправка через скрытую форму
    async function openProfileSession() {
        try {
            const payload = {
                action: "open_profile",
                timestamp: Date.now()
            };

            const jsonString = JSON.stringify(payload);

            const encryptedData = btoa(encodeURIComponent(jsonString).replace(/%([0-9A-F]{2})/g, function(match, p1) {
                return String.fromCharCode(parseInt(p1, 16));
            }));

            document.getElementById("profileEncryptedPayload").value = encryptedData;
            document.getElementById("profileTunnelForm").submit();

        } catch (error) {
            console.error("Ошибка открытия профиля через туннель:", error);
            window.location.href = '/Profile/Index';
        }
    }

    function isMobileLandscape() {
        return window.matchMedia("(max-width: 667px) and (orientation: landscape)").matches;
    }

    if (!isMobileLandscape()) {
        $("#area").css("height", getHeightInPx(92));
        $("#section-1").css("height", getHeightInPx(60));
        $("#section-2").css("height", getHeightInPx(30));
        $("#hro").css("height", getHeightInPx(60));
        $("#cntcts").css("height", getHeightInPx(58));
    } else {
        $("#area, #section-1, #section-2, #hro, #cntcts").css("height", "auto");
    }

    window.addEventListener("resize", function() {
        if (isMobileLandscape()) {
            $("#area, #section-1, #section-2, #hro, #cntcts").css("height", "auto");
        } else {
            $("#area").css("height", getHeightInPx(92));
            $("#section-1").css("height", getHeightInPx(60));
            $("#section-2").css("height", getHeightInPx(30));
            $("#hro").css("height", getHeightInPx(60));
            $("#cntcts").css("height", getHeightInPx(58));
        }
    });
</script>