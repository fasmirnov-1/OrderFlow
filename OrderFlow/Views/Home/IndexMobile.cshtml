@using OrderFlow.Domain.MainPage;
@using OrderFlow.Domain.MainPage.Models;
@using OrderFlow.Infrastructure.Entities;
@using OrderFlow.Application.Extensions;
@using Wangkanai.Detection.Models;

@inject Wangkanai.Detection.Services.IDetectionService DetectionService
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model OrderFlow.Domain.Page;
@{
    Layout = "~/Views/Shared/_BackgroundMobile.cshtml";

    Contacts contacts = Model.Children[Types.Contacts];
    List<OrderFlow.Domain.MainPage.Models.Service> services = Model.Children[Types.Services];
    List<Portfolio> portfolios = Model.Children[Types.Portfolio];
    List<Feedback> feedbacks = Model.Children[Types.Feedback];
    Details details = Model.Children[Types.Details];
}

<form id="secureTunnelForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="tunnelPayload" name="encryptedPayload" />
</form>

<form id="logoutForm" method="post" action="/Login/Logout" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div style="width: 100%; overflow-x: hidden;">

    <div id="hro" style="position: relative; width: 100%; min-height: 500px; overflow: hidden; margin: 0; padding: 0; overflow: visible">
        <picture style="display: block; width: 100%; height: 100%;">
            <source media="(max-width: 667px) and (orientation: landscape)" srcset="/img/HeroImage.png" />
            <img src="/img/HeroImageMobile.png" alt="Background" style="width: 100% !important; height: 100% !important; object-fit: cover; display: block;" />
        </picture>

        <div style="position: absolute; bottom: 20px; left: 0; width: 100%; padding: 0 20px; box-sizing: border-box; z-index: 10;">
            <div class="hero-actions" style="display: flex; flex-direction: column; gap: 12px; width: 100%;">
                <a href="javascript:void(0);" onclick="sendSecureRedirect('', false)" class="btn btn-primary">
                    <span>Заказать проект</span>
                </a>
                <a href="javascript:void(0);" onclick="sendSecureRedirect('', false)" class="btn btn-secondary">
                    <span>Смотреть кейсы</span>
                </a>

                <div class="user-profile-container" style="position: relative; display: inline-block;">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="login-blur-wrapper" style="position: relative; display: inline-block; margin-top: 10px;">
                            @* Используем класс btn btn-login-hero для идентичности с кнопкой Логин *@
                            <button type="button"
                                    class="btn btn-login-hero"
                                    onclick="toggleUserMenu(event)"
                                    style="display: flex; align-items: center; justify-content: center; min-width: 140px;">

                                <span>@(User.Identity.Name ?? "test4")</span>

                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 8px;">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>
                        </div>

                        @* Выпадающее меню *@
                        <div id="userDropdown" class="user-dropdown-menu" style="position: absolute; top: 100%; right: 0; margin-top: 5px; background: #ffffff; min-width: 200px; border: 1px solid #e5e7eb; border-radius: 8px; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); z-index: 99999; padding: 6px 0; display: none;">

                            <a class="user-dropdown-item"
                               onclick="sendSecureRedirect('/PageInDevelopment/Index', false)"
                               style="display: block; padding: 10px 16px; color: #374151; cursor: pointer; text-decoration: none; font-size: 14px;">
                                Редактировать профиль
                            </a>

                            <div class="user-dropdown-divider" style="height: 1px; background-color: #e5e7eb; margin: 4px 0;"></div>

                            <a class="user-dropdown-item"
                               onclick="document.getElementById('logoutForm').submit();"
                               style="display: block; padding: 10px 16px; color: #dc2626; cursor: pointer; text-decoration: none; font-size: 14px; font-weight: 500;">
                                Выход
                            </a>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="btn btn-login-hero" onclick="sendSecureRedirect('/Login/Index', {})">
                            <span>Логин</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <table id="area" class="workspace" style="width: 100%; border-collapse: collapse; margin-top: 20px;">

        <tr id="section-2">
            <td id="srvces" class="servicesplace" style="padding: 20px; display: block;">
                <h2 class="servicesheader">Наши услуги</h2>
                @if (services != null && services.Count > 0)
                {
                    <div class="services-list-mobile">@foreach (var s in services) {
                        <div class="service-card"><h3>@s.Name</h3><p>@s.Description</p></div>
                    }
                </div>
            } else
            {
                <div class="service-card" style="border: 1px dashed #D1D5DB; text-align: center; padding: 20px; color: #9CA3AF;"><p>Услуги не найдены</p></div>
            }
        </td>
    </tr>

    <tr id="section-3">
        <td id="cntcts" class="servicesplace" style="background: #f9fafb; padding: 20px; display: block;">
            <h2 class="servicesheader">Контакты</h2>
            <div style="font-size: 14px; display: flex; flex-direction: column; gap: 14px; color: #374151;">
                @if (contacts != null)
                {
                    <div style="display: flex; align-items: center; gap: 10px;"><span>📞</span> <strong>Телефон:</strong> <a href="tel:@contacts.Phone">@contacts.Phone</a></div>
                    <div style="display: flex; align-items: center; gap: 10px;"><span>✉️</span> <strong>Email:</strong> <a href="mailto:@contacts.Email">@contacts.Email</a></div>
                    <div style="display: flex; align-items: center; gap: 10px;"><span>✈️</span> <strong>Telegram:</strong> <a href="https://t.me/@contacts.Telegram.TrimStart('@')">@contacts.Telegram</a></div>
                    <div style="display: flex; align-items: center; gap: 10px;"><span>💬</span> <strong>WhatsApp:</strong> <a href="https://wa.me/@contacts.WatsApp.Replace(" ", "")">@contacts.WatsApp</a></div>
                }
                else
                {

                    <p>Данные контактов не указаны.</p>
                }
            </div>
        </td>
    </tr>

    <tr id="section-5">
        <td class="servicesplace" style="background: #f9fafb; padding: 20px; display: block;">
            <h2 class="servicesheader">Портфолио</h2>
            @if (portfolios != null && portfolios.Count > 0)
            {
                <div class="services-list-mobile">
                    @foreach (var p in portfolios)
                    {
                        <div class="service-card">
                            <h3>@p.ProjectName.Title</h3><p>Стек: @p.TechnologyName</p>
                                <a href="javascript:void(0);" onclick="sendSecureRedirect('', false)">Подробнее</a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="service-card" style="border: 1px dashed #D1D5DB; text-align: center; padding: 30px; color: #9CA3AF;"><p>Портфолио пока пусто.</p></div>
            }
        </td>
    </tr>

    <tr id="section-6">
        <td class="servicesplace" style="padding: 20px; display: block;">
            <h2 class="servicesheader">Отзывы</h2>
            @if (feedbacks != null && feedbacks.Count > 0)
            {
                <div class="services-list-mobile">
                    @foreach (var f in feedbacks)
                    {
                        <div class="service-card"><div>@for(int i=0; i<(int)f.Raiting; i++){
                            <span>★</span>
                        }
                    </div><p>@f.Text</p><small>@f.Name</small></div>
                }
            </div>
        } else
        {
            <div class="service-card" style="border: 1px dashed #D1D5DB; text-align: center; padding: 30px; color: #9CA3AF;"><p>Отзывов пока нет</p></div>
        }
    </td>
</tr>
</table>
</div>

<script type="text/javascript">
    // Функция переключения меню
        function toggleUserMenu(event) {
        if (event) {
            event.stopPropagation();
        }

        // Безопасная проверка: ищем элемент и проверяем его наличие
        const dropdown = document.getElementById('userDropdown');

        if (dropdown) {
            dropdown.classList.toggle('show');
        } else {
            console.error("Элемент с ID 'userDropdown' не найден в DOM.");
        }
    }

    // Исправленный глобальный обработчик
        document.addEventListener('click', (event) => {
        const dropdown = document.getElementById('userDropdown');
        const trigger = document.querySelector('.user-profile-name');

        // Проверяем:
        // 1. Существует ли меню
        // 2. Является ли клик НЕ внутри меню
        // 3. Является ли клик НЕ по кнопке (включая её содержимое)
        if (dropdown && !dropdown.contains(event.target) && trigger && !trigger.contains(event.target)) {
            dropdown.classList.remove('show');
        }
    });

    // Функция перехода на логин (прямой переход, так как это страница входа)
    function redirectToLogin() {
        window.location.href = '/Login';
    }
    // Новая логика: перенаправление на заглушку или указанный URL
    function sendSecureRedirect(targetUrl, isCustom = false) {
        const finalUrl = isCustom ? targetUrl : '/PageInDevelopment/Index';
        try {
            const data = {
                timestamp: new Date().getTime(),
                target: finalUrl,
                sessionHash: "@Html.Raw(ViewBag.SessionHash)"
            };
            const encryptedData = btoa(encodeURIComponent(JSON.stringify(data)).replace(/%([0-9A-F]{2})/g, (_, p1) => String.fromCharCode(parseInt(p1, 16))));
            const $form = $("#secureTunnelForm");
            $form.attr("action", finalUrl);
            $("#tunnelPayload").val(encryptedData);
            $form[0].submit();
        } catch (e) { window.location.href = finalUrl; }
    }
</script>