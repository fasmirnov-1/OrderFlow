@using OrderFlow.Domain.MainPage;
@using OrderFlow.Domain.MainPage.Models;
@using OrderFlow.Infrastructure.Entities;
@using OrderFlow.Application.Extensions;
@using Wangkanai.Detection.Models;

@inject Wangkanai.Detection.Services.IDetectionService DetectionService
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model OrderFlow.Domain.Page;
@{
    Layout = "~/Views/Shared/_BackgroundMobile.cshtml";

    Contacts contacts = Model.Children[Types.Contacts];
    List<OrderFlow.Domain.MainPage.Models.Service> services = Model.Children[Types.Services];
    List<Portfolio> portfolios = Model.Children[Types.Portfolio];
    List<Feedback> feedbacks = Model.Children[Types.Feedback];
    Details details = Model.Children[Types.Details];
}

<!-- Мобильный баннер-предупреждение без ошибок -->
<div id="cryptoWarningBannerMobile" style="display:none; background: #fff3cd; color: #856404; border-bottom: 1px solid #ffeeba; padding: 10px 15px; text-align: center; font-size: 13px; position: relative; z-index: 100000; box-sizing: border-box;">
    <span><strong>Внимание:</strong> Шифрование ограничено по HTTP.</span>
    <button type="button" onclick="runMobileCryptoFix()" style="background: #856404; color: #fff; border: none; padding: 4px 10px; margin-left: 8px; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: 500;">Настроить</button>
    <button type="button" onclick="document.getElementById('cryptoWarningBannerMobile').style.display='none';" style="background: transparent; border: none; font-size: 15px; font-weight: bold; cursor: pointer; margin-left: 8px; color: #856404;">&times;</button>

    <!-- Поле для удобного копирования ссылки на флаги в мобильном браузере -->
    <div id="mobileCryptoFixContainer" style="margin-top: 8px; display: none; font-size: 12px;">
        <span>Ссылка на настройки:</span>
        <input type="text" id="mobileFlagsUrlInput" readonly style="width: 100%; max-width: 280px; padding: 3px; font-size: 11px; border: 1px solid #ccc; border-radius: 3px; background: #fff; margin-top: 3px; display: block; margin-left: auto; margin-right: auto;" />
    </div>
</div>

<form id="secureTunnelForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="tunnelPayload" name="encryptedPayload" />
</form>

<!-- Скрытая форма для безопасного открытия профиля через крипто-туннель -->
<form id="profileTunnelForm" asp-controller="Profile" asp-action="Index" method="post" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="profileEncryptedPayload" name="encryptedPayload" />
</form>

<form id="logoutForm" method="post" action="/Login/Logout" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div style="width: 100%; overflow-x: hidden;">

    <div id="hro" style="position: relative; width: 100%; min-height: 500px; overflow: hidden; margin: 0; padding: 0; overflow: visible">
        <picture style="display: block; width: 100%; height: 100%;">
            <source media="(max-width: 667px) and (orientation: landscape)" srcset="/img/HeroImage.png" />
            <img src="/img/HeroImageMobile.png" alt="Background" style="width: 100% !important; height: 100% !important; object-fit: cover; display: block;" />
        </picture>

        <div style="position: absolute; bottom: 20px; left: 0; width: 100%; padding: 0 20px; box-sizing: border-box; z-index: 10;">
            <div class="hero-actions" style="display: flex; flex-direction: column; gap: 12px; width: 100%;">
                <a href="javascript:void(0);" onclick="securePostRedirect('/PageInDevelopment/Index', { action: 'order' })" class="btn btn-primary">
                    <span>Заказать проект</span>
                </a>
                <a href="javascript:void(0);" onclick="securePostRedirect('/PageInDevelopment/Index', { action: 'cases' })" class="btn btn-secondary">
                    <span>Смотреть кейсы</span>
                </a>

                <div class="user-profile-container" style="position: relative; display: inline-block;">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="login-blur-wrapper" style="position: relative; display: inline-block; margin-top: 10px;">
                            <button type="button"
                                    class="btn btn-login-hero"
                                    onclick="toggleUserMenu(event)"
                                    style="display: flex; align-items: center; justify-content: center; min-width: 140px;">

                                <span>@(User.Identity.Name ?? "test4")</span>

                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 8px;">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>
                        </div>

                        <div id="userDropdown" class="user-dropdown-menu" style="position: absolute; top: 100%; right: 0; margin-top: 5px; background: #ffffff; min-width: 200px; border: 1px solid #e5e7eb; border-radius: 8px; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); z-index: 99999; padding: 6px 0; display: none;">

                            <!-- ПРАВИЛЬНЫЙ ВЫЗОВ ПРОФИЛЯ С ИСПОЛЬЗОВАНИЕМ КРИПТО-ТУННЕЛЯ ИЗ Index.cshtml -->
                            <a class="user-dropdown-item"
                               onclick="openMobileProfileSession()"
                               style="display: block; padding: 10px 16px; color: #374151; cursor: pointer; text-decoration: none; font-size: 14px;">
                                Редактировать профиль
                            </a>

                            <div class="user-dropdown-divider" style="height: 1px; background-color: #e5e7eb; margin: 4px 0;"></div>

                            <a class="user-dropdown-item"
                               onclick="handleLogout(event)"
                               style="display: block; padding: 10px 16px; color: #dc2626; cursor: pointer; text-decoration: none; font-size: 14px; font-weight: 500;">
                                Выход
                            </a>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="btn btn-login-hero" onclick="securePostRedirect('/Login/Index', {})">
                            <span>Логин</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <table id="area" class="workspace" style="width: 100%; border-collapse: collapse; margin-top: 20px;">

        <tr id="section-2">
            <td id="srvces" class="servicesplace" style="padding: 20px; display: block;">
                <h2 class="servicesheader">Наши услуги</h2>
                @if (services != null && services.Count > 0)
                {
                    <div class="services-list-mobile">
                        @foreach (var s in services)
                        {
                            <div class="service-card">
                                <h3>@s.Name</h3>
                                <p>@s.Description</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="service-card" style="border: 1px dashed #D1D5DB; text-align: center; padding: 20px; color: #9CA3AF;"><p>Услуги не найдены</p></div>
                }
            </td>
        </tr>

        <tr id="section-3">
            <td id="cntcts" class="servicesplace" style="background: #f9fafb; padding: 20px; display: block;">
                <h2 class="servicesheader">Контакты</h2>
                <div style="font-size: 14px; display: flex; flex-direction: column; gap: 14px; color: #374151;">
                    @if (contacts != null)
                    {
                        <div style="display: flex; align-items: center; gap: 10px;"><span>📞</span> <strong>Телефон:</strong> <a href="tel:@contacts.Phone">@contacts.Phone</a></div>
                        <div style="display: flex; align-items: center; gap: 10px;"><span>✉️</span> <strong>Email:</strong> <a href="mailto:@contacts.Email">@contacts.Email</a></div>
                        <div style="display: flex; align-items: center; gap: 10px;"><span>✈️</span> <strong>Telegram:</strong> <a href="https://t.me/@contacts.Telegram.TrimStart('@')">@contacts.Telegram</a></div>
                        <div style="display: flex; align-items: center; gap: 10px;"><span>💬</span> <strong>WhatsApp:</strong> <a href="https://wa.me/@contacts.WatsApp.Replace(" ", "")">@contacts.WatsApp</a></div>
                    }
                    else
                    {
                        <p>Данные контактов не указаны.</p>
                    }
                </div>
            </td>
        </tr>

        <tr id="section-5">
            <td class="servicesplace" style="background: #f9fafb; padding: 20px; display: block;">
                <h2 class="servicesheader">Портфолио</h2>
                @if (portfolios != null && portfolios.Count > 0)
                {
                    <div class="services-list-mobile">
                        @foreach (var p in portfolios)
                        {
                            <div class="service-card">
                                <h3>@p.ProjectName.Title</h3>
                                <p>Стек: @p.TechnologyName</p>
                                <a href="/PageInDevelopment/Index" onclick="event.preventDefault(); securePostRedirect('/PageInDevelopment/Index', { projectId: '@p.ProjectName.Title' });">Подробнее</a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="service-card" style="border: 1px dashed #D1D5DB; text-align: center; padding: 30px; color: #9CA3AF;"><p>Портфолио пока пусто.</p></div>
                }
            </td>
        </tr>

        <tr id="section-6">
            <td class="servicesplace" style="padding: 20px; display: block;">
                <h2 class="servicesheader">Отзывы</h2>
                @if (feedbacks != null && feedbacks.Count > 0)
                {
                    <div class="services-list-mobile">
                        @foreach (var f in feedbacks)
                        {
                            <div class="service-card">
                                <div>
                                    @for (int i = 0; i < (int)f.Raiting; i++)
                                    {
                                        <span>★</span>
                                    }
                                </div>
                                <p>@f.Text</p>
                                <small>@f.Name</small>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="service-card" style="border: 1px dashed #D1D5DB; text-align: center; padding: 30px; color: #9CA3AF;"><p>Отзывов пока нет</p></div>
                }
            </td>
        </tr>
    </table>
</div>

<script type="text/javascript" src="~/Scripts/jquery-4.0.0.min.js"></script>
<script type="text/javascript" src="~/Scripts/crypto-tunnel.js"></script>

<script type="text/javascript">
    // Автоматическая проверка при загрузке мобильной страницы
    document.addEventListener("DOMContentLoaded", function() {
        (async function() {
            let isCryptoWorking = false;
            try {
                if (window.crypto && window.crypto.subtle) {
                    const msgUint8 = new TextEncoder().encode("test");
                    await window.crypto.subtle.digest("SHA-256", msgUint8);
                    isCryptoWorking = true;
                }
            } catch (e) {
                isCryptoWorking = false;
            }

            if (!isCryptoWorking) {
                var banner = document.getElementById("cryptoWarningBannerMobile");
                if (banner) {
                    banner.style.display = "block";
                }
            }
        })();
    });

    function toggleUserMenu(event) {
        if (event) {
            event.stopPropagation();
        }
        const dropdown = document.getElementById('userDropdown');
        if (dropdown) {
            dropdown.classList.toggle('show');
            // Дублируем управление style.display для абсолютной надежности на мобильных
            if (dropdown.style.display === "block") {
                dropdown.style.display = "none";
            } else {
                dropdown.style.display = "block";
            }
        } else {
            console.error("Элемент с ID 'userDropdown' не найден в DOM.");
        }
    }

    document.addEventListener('click', (event) => {
        const dropdown = document.getElementById('userDropdown');
        const trigger = document.querySelector('.user-profile-container');
        if (dropdown && !dropdown.contains(event.target) && trigger && !trigger.contains(event.target)) {
            dropdown.classList.remove('show');
            dropdown.style.display = "none";
        }
    });

    // Специализированный метод для безопасного выхода из системы (синхронизирован с Index.cshtml)
    function handleLogout(event) {
        event.preventDefault();
        var token = $('input[name="__RequestVerificationToken"]').val();
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Login/Logout';

        if (token) {
            var tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = token;
            form.appendChild(tokenInput);
        }

        document.body.appendChild(form);
        form.submit();
    }

    async function securePostRedirect(targetUrl, payload) {
        try {
            const response = await sendTunnelRequest(targetUrl, payload);
            if (response.ok) {
                window.location.href = targetUrl;
            } else {
                console.warn("Туннель отклонен сервером, пробуем прямой переход.");
                window.location.href = targetUrl;
            }
        } catch (e) {
            console.error("Ошибка крипто-туннеля:", e);
            window.location.href = targetUrl;
        }
    }

    // Метод для безопасного открытия профиля через крипто-туннель (синхронизирован с Index.cshtml)
    async function openMobileProfileSession() {
        try {
            const payload = {
                action: "open_profile",
                timestamp: Date.now()
            };

            const jsonString = JSON.stringify(payload);

            const encryptedData = btoa(encodeURIComponent(jsonString).replace(/%([0-9A-F]{2})/g, function(match, p1) {
                return String.fromCharCode(parseInt(p1, 16));
            }));

            document.getElementById("profileEncryptedPayload").value = encryptedData;
            document.getElementById("profileTunnelForm").submit();

        } catch (error) {
            console.error("Ошибка открытия профиля через туннель:", error);
            window.location.href = '/Profile/Index';
        }
    }
</script>