<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OrderFlow</title>

    <link rel="stylesheet" type="text/css" href="/Scripts/CSS/UserRegister.css" />
    <style>
            /* Подсветка полей с ошибками валидации */
            .auth-form input.input-validation-error {
                border-color: #ef4444 !important;
            }

                .auth-form input.input-validation-error:focus {
                    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15) !important;
                }
    </style>
</head>
<body>
    <div class="main-wrapper">
        @RenderBody()
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>