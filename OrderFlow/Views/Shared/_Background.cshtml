<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Создание приложений на заказ и автоматизация бизнеса - OrderFlow</title>
    <meta name="description" content="OrderFlow — ваш программист в мире автоматизации. Мы осуществляем создание приложений на заказ любой сложности. Удобные, надежные и доступные программы для всех сфер бизнеса." />
    <meta name="keywords" content="создание приложений на заказ, программы для всех, ваш программист, orderflow, разработка по, автоматизация процессов" />

    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="http://createsoft.orderflow.abrdns.com/" />
    <link rel="alternate" media="only screen and (max-width: 640px)" href="http://createsoft.orderflow.abrdns.com/Home/IndexMobile" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OrderFlow" />
    <meta property="og:title" content="Создание приложений на заказ и автоматизация бизнеса" />
    <meta property="og:description" content="OrderFlow — ваш программист в мире автоматизации. Доступные программы для всех сфер бизнеса." />
    <meta property="og:url" content="https://createsoft.orderflow.abrdns.com/" />
    <meta property="og:image" content="http://createsoft.orderflow.abrdns.com/img/ogimg.png" />

    <meta name="google-site-verification" content="1IrztySemQmFTJ4EwxGJ6YHeE2DJZbufyfC6VGaYly0" />

     <link rel="stylesheet" href="~/Scripts/CSS/Background.css" />
</head>
<body>
    <div id="screenSpace" class="workspace">
        <div id="header" class="headers" style="border: 1px solid black">
            <span class="headertext">@Model.Header</span>
        </div>
        @RenderBody()
    </div>

    <script type="text/javascript" src="~/Scripts/Background.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery-4.0.0.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
        $("#screenSpace").css("height", getHeightInPx(97));
        $("#screenSpace").css("width", getWidthInPx(97));
        $("#header").css("height", getHeightInPx(5));
        });
    </script>
</body>
