<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>

    <link rel="stylesheet" href="~/Scripts/CSS/BackgroundMobile.css" />
</head>
<body id="bdy">
    <div id="screenSpace" class="workspace">
        <div id="header" class="headers" style="border: 1px solid black; align-content:center;">
            <span class="headertext">@Model.Header</span>
        </div>
        @RenderBody()
    </div>

    <script type="text/javascript" src="~/Scripts/Background.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery-4.0.0.min.js"></script>

    <script type="text/javascript">
        $("#bdy").css("width", getWidthInPx(100));
    </script>
</body>
</html>
