@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Views/Shared/_Register.cshtml";
    ViewData["Title"] = "Регистрация успешна";
}

<div class="auth-container">
    <div class="auth-card success-card">

        <div class="success-icon-wrapper">
            <svg class="icon-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
        </div>

        <div class="auth-header">
            <h2>Регистрация завершена!</h2>
            <p class="success-message">
                Учетная запись для системы <strong>OrderFlow</strong> успешно создана.
                Теперь вы можете войти, используя свой логин и пароль.
            </p>
        </div>

        <div class="success-actions">
            <a asp-controller="Login" asp-action="Index" class="btn-auth-submit btn-success-proceed" style="background-color: #2563eb;">
                <span>Перейти к входу</span>
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                    <polyline points="10 17 15 12 10 7"></polyline>
                    <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
            </a>
        </div>

    </div>
</div>